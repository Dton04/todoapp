# ==========================================
# 1. DEPENDENCIES & PACKAGES
# ==========================================
node_modules/
*/node_modules/
.pnp
.pnp.js

# ==========================================
# 2. ENVIRONMENT & SECRETS
# ==========================================
.env
.env.*
!.env.example
!*.env.example
backend/.env
frontend/.env
*.pem
*.key
*.pub
id_rsa
keygen

# ==========================================
# 3. TERRAFORM SENSITIVE FILES
# ==========================================
# Local .terraform directories
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfstate.backup

# Sensitive variables (contains DigitalOcean / Cloud API Tokens)
*.tfvars
*.tfvars.json
!*.tfvars.example

# Terraform execution and crash logs
crash.log
crash.*.log
*.tfplan
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.rc
terraform.rc

# ==========================================
# 4. ANSIBLE SENSITIVE FILES
# ==========================================
ansible/hosts.ini
*.retry

# ==========================================
# 5. BUILD & PRODUCTION ARTIFACTS
# ==========================================
build/
dist/
coverage/

# ==========================================
# 6. LOGS & OS MISC
# ==========================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
.vscode/
.idea/
